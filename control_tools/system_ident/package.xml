<?xml version="1.0"?>
<package format="3">
  <name>system_ident</name>
  <version>0.0.1</version>
  <description>Generate base velocity commands to identify system dynamics.</description>

  <maintainer email="tiago.giacomelli@senairs.org.br">Tiago Giacomelli</maintainer>
  <license>Copyright (c) 2024, ISI SIM</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
